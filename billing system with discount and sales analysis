#include <iostream>
using namespace std;

float totalBillAmount(float itemPrice[], int itemCount) {
    float total = 0.0;
    for (int i = 0; i < itemCount; i++) {
        total += itemPrice[i];
    }
    return total;

}

float calculateDiscount(float totalBill, int itemCount) {
    float discountRate = 0.0;

    if (totalBill >= 5000) {
        discountRate = 0.10;
    }
    else if (totalBill >= 3000) {
        discountRate = 0.05;
    }

    if (itemCount > 10) {
        discountRate+=0.02;
    }

    float discount = totalBill * discountRate;

    return discount;
}

float finalAmount(float discount, float totalBill) {
    float finalAmount = totalBill-discount;
    return finalAmount;
}


