#include <iostream>
using namespace std;
int main() {
	int term1 = 0;
	int term2 = 1;
	int n = 0;
	int NextTerm = 0;
	cout << "===== fibonacci Sequence =======" << endl;
	cout << endl;

	cout << "Enter your diserable Term of Fibonacci Srquence: ";
	cin >> n;

	if (n <= 3)
	{
		cout << "The Provided Number must be >= 3!";
		return 1;
	}

	cout << term1 << " , " << term2 << " , ";

	for (int i = 3; i <= n; i++)
	{
		NextTerm = term1 + term2;
		cout << NextTerm;
		if (i != n)
		{
			cout << " , ";
		}
		term1 = term2;
		term2 = NextTerm;
	}

}
