#include <iostream>
using namespace std;

int main()
{
	int n;

	cout << "Enter the number of element:" << endl;
	cin >> n;

	float array[100];
	float* ptr = array;
	float sum = 0;

	for (int i = 0; i < n; i++)
	{
		cout << "Enter the number in an array at position [" << i << "]: " << endl;
		cin >> *(ptr + i);

		sum += *(ptr + i);
	}

	float average = sum / n;

	cout << "Average of the given array is : " << average << endl;
}

