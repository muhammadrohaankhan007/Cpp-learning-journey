#include <iostream>
#include <string>

using namespace std;

// Independent Parent 1: Handles Sales Data
class Sales {
protected:
    float salesArray[3];

public:
    void getData() {
        cout << "Enter Sales for last 3 months: " << endl;
        for (int i = 0; i < 3; i++) {
            cout << "  Month " << i + 1 << ": ";
            cin >> salesArray[i];
        }
    }

    void putData() {
        cout << "Sales History: ";
        for (int i = 0; i < 3; i++) {
            cout << "$" << salesArray[i] << (i < 2 ? ", " : "");
        }
        cout << endl;
    }
};

